# Copy to .env.local for development. In production set these in the host's
# environment settings; the server refuses to start requests without them.

# "devnet" (test money) or "mainnet-beta" (real USDC). Required in production.
SOLANA_CLUSTER=devnet

# Postgres connection string. Use the provider's pooled (transaction-mode) URL
# on serverless hosts. Required in production.
DATABASE_URL=postgres://localhost:5432/paylink

# Dedicated Solana RPC endpoint (Helius, Triton, QuickNode, ...). Required for
# mainnet in production; the public endpoint is rate limited.
SOLANA_RPC_URL=
